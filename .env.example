# Ordered, comma-separated AI providers for case generation; the next one is tried on timeout, 429, 5xx or network errors.
# Known: claude-sonnet, claude-haiku, mock. Defaults to claude-sonnet,claude-haiku when unset.
AI_PROVIDERS=claude-sonnet,claude-haiku
# Cheap provider list for the topic safety check and comic-panel narration. Defaults to claude-haiku when unset.
AI_SAFETY_PROVIDERS=claude-haiku
# Anthropic API key for the Claude providers; used server-side only.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Neon Postgres pooled connection string, used by the app at runtime.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Neon direct (unpooled) connection string, used by drizzle-kit migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# Optional: Vercel "Protection Bypass for Automation" secret, so scripts/smoke.sh can check protected preview deployments.
VERCEL_PROTECTION_BYPASS=
# Optional: brand-new topic cases the whole site may generate per New York day (budget guard). Defaults to 40.
GENERATION_DAILY_CAP=40
